FROM fedora:latest

# Install dependencies needed for build and tests
RUN dnf update -y && dnf install -y \
    gcc \
    golang \
    git \
    make \
    sudo \
    file \
    && dnf clean all

# Add a test user
RUN useradd -m -s /bin/bash tester && \
    echo "tester ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/tester

# Set working directory
WORKDIR /mbvpn

# We'll copy the project files at runtime
CMD ["/bin/bash"]